# Supabase（Supabaseダッシュボード > Settings > API から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenWeatherMap（https://openweathermap.org/api でサインアップして取得）
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth（Google Cloud Console > APIs & Services > Credentials から取得）
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx

# Anthropic（https://console.anthropic.com でAPIキーを取得）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# Capacitor（iOSアプリ化する場合のみ。詳細は docs/ios-app.md）
# ネイティブシェルが読み込むデプロイ先URL
CAP_SERVER_URL=https://xxxxxxxx.vercel.app

# RevenueCat（App Store 課金。詳細は docs/app-store.md）
# iOS の公開APIキー（appl_ で始まる。クライアントに出るので公開前提のキー）
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxx
# RevenueCat > Integrations > Webhooks に設定する Authorization ヘッダーの値（自分で決める）
REVENUECAT_WEBHOOK_SECRET=任意の長いランダム文字列
